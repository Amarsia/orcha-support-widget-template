# Required
AMARSIA_PROJECT_KEY=
VISITOR_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Comma-separated origins allowed to frame /widget.
# Example: https://www.example.com,https://app.example.com
# If omitted, any origin may embed the widget.
WIDGET_ALLOWED_ORIGINS=

# Optional custom Amarsia API endpoint
AMARSIA_API_URL=https://api.amarsia.com
